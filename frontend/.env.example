# Auth0 configuration — Authorization Code + PKCE (S256) ONLY
#
# REQUIRED for login to work. Leaving these empty is fine for local
# development — the app will display a banner and bypass auth checks.
#
# For real Auth0 integration:
#   1. Create an Auth0 Application (type: Single Page Application)
#   2. Under Settings → Application URIs, add http://localhost:5173
#      to Allowed Callback URLs, Allowed Logout URLs, Allowed Web Origins
#   3. Enable "Authorization Code + PKCE" grant under Application URIs
#   4. Fill in the three variables below
#
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

# Backend API base URL — used by future fetch() wrappers
VITE_API_BASE_URL=http://localhost:3000
